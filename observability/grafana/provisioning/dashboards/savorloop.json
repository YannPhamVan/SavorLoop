{
  "id": null,
  "uid": "savorloop-inventory",
  "title": "SavorLoop natural-language inventory updates",
  "tags": ["savorloop", "operational"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Inventory update requests",
      "datasource": {
        "type": "prometheus",
        "uid": "savorloop-prometheus"
      },
      "targets": [
        {
          "expr": "sum(savorloop_inventory_update_requests_total)",
          "legendFormat": "requests",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Inventory update errors",
      "datasource": {
        "type": "prometheus",
        "uid": "savorloop-prometheus"
      },
      "targets": [
        {
          "expr": "sum(savorloop_inventory_update_errors_total)",
          "legendFormat": "errors",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "AI validation failures",
      "datasource": {
        "type": "prometheus",
        "uid": "savorloop-prometheus"
      },
      "targets": [
        {
          "expr": "sum(savorloop_inventory_update_ai_validation_failures_total)",
          "legendFormat": "validation failures",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Inventory update duration (seconds)",
      "datasource": {
        "type": "prometheus",
        "uid": "savorloop-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(savorloop_inventory_update_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(savorloop_inventory_update_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "savorloop-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(savorloop_inventory_update_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 0,
        "y": 13
      }
    }
  ]
}
